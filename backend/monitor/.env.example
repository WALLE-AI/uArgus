# ── Redis (Upstash) ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# ── Agents Service (HTTP fallback when LLM_PROVIDER is empty) ─
AGENTS_URL=http://localhost:3001

# ── LLM Provider (direct, replaces AGENTS_URL when set) ──────
# Supported: anthropic | openai | ollama | vllm | openai_compat
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ── Embedding (BGE-M3 via OpenAI-compat /v1/embeddings) ──────
# EMBEDDING_API_URL can be:
#   - Ollama base URL:        http://localhost:11434   (model: bge-m3)
#   - SiliconFlow full URL:   https://api.siliconflow.cn/v1/embeddings  (model: BAAI/bge-m3)
#   - vLLM base URL:          http://localhost:8000   (model: BAAI/bge-m3)
EMBEDDING_API_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=

# ── Chroma Vector Store ─────────────────────────────────────
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=news_embeddings

# ── Proxy ────────────────────────────────────────────────────
PROXY_RELAY_URL=
PROXY_CONNECT_URL=
PROXY_CURL_URL=

# ── Server ───────────────────────────────────────────────────
PORT=8090
ENV=development

# ── Feature Flags ────────────────────────────────────────────
SIDECAR_MODE=false
